# Copy this file to .env before starting the stack.
# Pin this to an immutable digest after validating the image in your registry.
OZONE_IMAGE=apache/ozone:2.2.1-all-in-one

# The upstream image is run as root for local/staging compatibility.
# A production image should run as a dedicated non-root UID/GID.
OZONE_RUNTIME_USER=0:0

# Keep these values aligned with the number of DataNodes.
OZONE_REPLICATION_FACTOR=3
OZONE_SAFEMODE_MIN_DATANODES=3

# Leave empty for normal startup. Set temporarily to --upgrade only during a
# non-rolling Ozone version upgrade, then remove it again.
OM_START_ARGS=

# Management APIs stay on localhost by default. Put S3G behind a firewall/LB
# before changing this to 0.0.0.0 or a host interface address.
ADMIN_BIND_ADDRESS=127.0.0.1
S3G_BIND_ADDRESS=127.0.0.1
